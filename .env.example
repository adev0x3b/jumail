# Copy to .env (never committed). Everything secret lives here.

# Identity. The hostname is also the docker network alias apps connect to.
JUMAIL_HOSTNAME=mail.juume.site
JUMAIL_DOMAIN=juume.site
JUMAIL_DKIM_SELECTOR=jumail

# TLS: "acme" = Let's Encrypt via Cloudflare DNS-01 (needs the token below);
# "selfsigned" = certificates from `./jumail certs`, apps trust certs/ca.pem.
JUMAIL_TLS=acme
ACME_EMAIL=you@example.com
# Cloudflare API token with only Zone > DNS > Edit on the juume.site zone.
CLOUDFLARE_API_TOKEN=

# Upstream relay. Resend: user is literally "resend", password is an API key
# (free: 100/day, 3000/month). Brevo: smtp-relay.brevo.com, account email + SMTP key.
RELAY_HOST=smtp.resend.com
RELAY_PORT=587
RELAY_USER=resend
RELAY_PASSWORD=
# SPF include for the root domain, printed by `./jumail dns`. Leave empty for
# Resend (its SPF lives on the send.<domain> subdomain it asks you to create);
# spf.brevo.com for Brevo.
RELAY_SPF_INCLUDE=

# Global sending budget across all apps: burst per period (Resend allows 100/day).
JUMAIL_RATE_BURST=20
JUMAIL_RATE_PERIOD=1h

# Loopback port on the host for clients that don't run in docker.
JUMAIL_LOOPBACK_PORT=587
